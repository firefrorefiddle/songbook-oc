\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{songbook-layout}[2026/04/24 Custom songbook layout]

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

\definecolor{SongNumberBg}{gray}{0.82}

% ---------- Global layout ----------

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\newlength\SongLeftNumberWidth
\setlength\SongLeftNumberWidth{3.1em}

\newlength\SongHeaderGap
\setlength\SongHeaderGap{0.45em}

\newlength\SongVerseNumberWidth
\setlength\SongVerseNumberWidth{2.5em}

\newlength\SongBodyIndent
\setlength\SongBodyIndent{3.5em}

\newlength\SongVerseSep
\setlength\SongVerseSep{1.7em}

\newlength\SongLineSep
\setlength\SongLineSep{0.15em}

% Adaptive width of the gray number box (grows past \SongLeftNumberWidth for
% multi-digit numbers). Computed per song in \BeginSong.
\newlength\SongNumberBoxWidth

% Scratch state for \Ch. Named registers/boxes are required because
% tabular/\halign clobbers the unnamed scratch registers (\dimen0, \box0...),
% which previously corrupted cell widths and overlapped lyrics.
\newlength\SongChCellWidth
\newsavebox\SongChLyrBox
\newsavebox\SongChChordBox

\newcommand{\SongTitleFont}{\sffamily\slshape\LARGE}
\newcommand{\SongMetaFont}{\scriptsize}
\newcommand{\SongMetaStrongFont}{\scriptsize\bfseries}
\newcommand{\SongNumberFont}{\sffamily\bfseries\Huge}
\newcommand{\SongLyricFont}{\rmfamily\normalsize}
\newcommand{\SongChordFont}{\sffamily\slshape\normalsize}

% ---------- Song block ----------

% Usage:
% \BeginSong{1}{Title}{Reference}{T/M: Author}{Copyright}
% ...
% \EndSong

\NewDocumentCommand{\BeginSong}{m m m m m}{%
  \Needspace{9\baselineskip}%
  \def\SongCurrentCopyright{#5}%
  \vspace{0.5em}%
  \hrule height 0.4pt%
  \vspace{0.55em}%
  \noindent
  % Guard so single-song previews (no hyperref) still compile; the full songbook
  % build loads hyperref and gets real anchors for the index links.
  \ifcsname hypertarget\endcsname\hypertarget{song-#1}{}\fi%
  % Grow the gray box to fit wide (e.g. 3-digit) numbers, keeping
  % \SongLeftNumberWidth as a minimum, and track that width in the title hsize.
  \settowidth{\SongNumberBoxWidth}{\SongNumberFont #1}%
  \ifdim\SongNumberBoxWidth<\SongLeftNumberWidth
    \setlength\SongNumberBoxWidth{\SongLeftNumberWidth}%
  \fi
  \hbox{%
    \colorbox{SongNumberBg}{%
      \hbox to \SongNumberBoxWidth{%
        \SongNumberFont #1\hfil
      }%
    }%
    \hspace{\SongHeaderGap}%
    \vtop{%
      \hsize=\dimexpr\linewidth-\SongNumberBoxWidth-\SongHeaderGap\relax
      {\SongTitleFont #2\par}%
      \vspace{0.15em}%
      {\SongMetaFont #3\par}%
      {\SongMetaStrongFont #4\par}%
    }%
  }%
  \vspace{2.6em}%
}

\NewDocumentCommand{\EndSong}{}{%
  \vfill
  {\scriptsize \SongCurrentCopyright\par}%
  \vspace{0.15em}%
  \hrule height 0.4pt%
  \clearpage
}

% For multiple songs per page later, replace \clearpage above
% with a softer policy. For now it matches one-song-per-page testing.

% ---------- Verse block ----------

% Usage:
% \BeginVerse{1}
%   \SongLine{...}
% \EndVerse

\NewDocumentCommand{\BeginVerse}{m}{%
  \Needspace{5\baselineskip}%
  \vspace{\SongVerseSep}%
  \noindent
  \hbox\bgroup
    \hbox to \SongVerseNumberWidth{\SongLyricFont #1.\hfil}%
    \vtop\bgroup
      \hsize=\dimexpr\linewidth-\SongVerseNumberWidth-\SongBodyIndent\relax
      \SongLyricFont
}

\NewDocumentCommand{\EndVerse}{}{%
    \egroup
  \egroup
  \par
}

% Unnumbered section, e.g. chorus/bridge.
\NewDocumentCommand{\BeginSection}{m}{%
  \Needspace{5\baselineskip}%
  \vspace{\SongVerseSep}%
  \noindent
  \hbox\bgroup
    \hbox to \SongVerseNumberWidth{\SongLyricFont #1\hfil}%
    \vtop\bgroup
      \hsize=\dimexpr\linewidth-\SongVerseNumberWidth-\SongBodyIndent\relax
      \SongLyricFont
}

\NewDocumentCommand{\EndSection}{}{%
    \egroup
  \egroup
  \par
}

% ---------- Lines ----------

\NewDocumentCommand{\SongLine}{m}{%
  \noindent #1\par\vspace{\SongLineSep}%
}

% Chord over lyric fragment.
%
% Usage:
%   \Ch{C}{word}
%
% Important:
% Haskell should choose the lyric fragment. Usually this is the
% syllable/word beginning at the chord anchor.
\NewDocumentCommand{\Ch}{m m}{%
  \leavevmode
  \begingroup
  \sbox\SongChLyrBox{{\SongLyricFont #2}}%
  \sbox\SongChChordBox{{\SongChordFont #1}}%
  \setlength\SongChCellWidth{\wd\SongChLyrBox}%
  \ifdim\wd\SongChChordBox>\SongChCellWidth
    \setlength\SongChCellWidth{\wd\SongChChordBox}%
  \fi
  \begin{tabular}[b]{@{}c@{}}%
    {\SongChordFont #1}\\[-0.35ex]%
    \hbox to \SongChCellWidth{{\SongLyricFont #2}\hfil}%
  \end{tabular}%
  \endgroup
}

% Chord with no lyric fragment, if unavoidable.
\NewDocumentCommand{\ChordOnly}{m}{%
  \leavevmode
  \begin{tabular}[b]{@{}c@{}}%
    {\SongChordFont #1}\\[-0.35ex]%
    \strut
  \end{tabular}%
}

% ---------- Repeats ----------

\NewDocumentCommand{\LRep}{}{%
  \raisebox{-0.15ex}{\textbf{|:}}\kern0.08em%
}

\NewDocumentCommand{\RRep}{}{%
  \kern0.08em\raisebox{-0.15ex}{\textbf{:|}}%
}

% ---------- Notes ----------

\NewDocumentCommand{\SongTextNote}{m}{%
  \par\vspace{0.4em}%
  {\small\itshape #1\par}%
  \vspace{0.3em}%
}

\NewDocumentCommand{\SongMusicNote}{m}{%
  \par\vspace{0.4em}%
  {\small #1\par}%
  \vspace{0.3em}%
}

% songmaker emits `songs.sty` macro names in native TeX; define them here (no `songs` package).
\newcommand{\songbookOC@gobblebreak}{\@ifnextchar\\{\@gobble}{}}
\providecommand{\textnote}[1]{\SongTextNote{#1}\songbookOC@gobblebreak}
\providecommand{\musicnote}[1]{\SongMusicNote{#1}\songbookOC@gobblebreak}

% Raw `\begin{intersong}...\end{intersong}` blocks pass through from .sng (see `songs.sty`).
\newenvironment{intersong}{%
  \par\vspace{0.75\baselineskip}%
  \begingroup
  \small
  \setlength{\parskip}{0.35\baselineskip}%
}{\par\endgroup\vspace{0.75\baselineskip}\par}%
\newenvironment{intersong*}{%
  \begin{intersong}%
}{%
  \end{intersong}%
}%